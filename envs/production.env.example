# Profil target env PRODUCTION. Salin menjadi envs/production.env lalu isi kredensialnya.
# Nama file (production) = kunci target_env di history, preset_links, dan daftar tenant: jangan diganti.

STUDIO_ENV_LABEL=Production
STUDIO_ENV_COLOR=rose
# Read-only: semua operasi tulis ke DB ditolak. Perubahan lewat preset + review.
STUDIO_ENV_READONLY=true
STUDIO_ENV_PROTECTED=true
# Kode tenant di env ini berakhiran _PROD (IDM_PROD); ditambahkan otomatis saat "Tambah Tenant"
STUDIO_TENANT_CODE_SUFFIX=_PROD

DB_HOST=
DB_PORT=5432
# Sebaiknya user DB dengan hak SELECT saja
DB_USERNAME=
DB_PASSWORD=
DB_NAME=ats_db
DB_SSL=false
