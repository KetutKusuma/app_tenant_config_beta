# Contoh profil target env. Salin menjadi envs/<nama>.env (nama: huruf kecil, angka, - atau _).
# File baru otomatis muncul di pemilih env Studio tanpa restart BFF.

STUDIO_ENV_LABEL=Staging
# Warna badge: slate | indigo | emerald | amber | rose | sky | violet | teal
STUDIO_ENV_COLOR=amber
# true = semua operasi tulis ke DB ditolak (cocok untuk production; ubah lewat preset + review)
STUDIO_ENV_READONLY=false
# true = setiap operasi tulis wajib konfirmasi dengan mengetik nama profil
STUDIO_ENV_PROTECTED=true

# Pilih salah satu: DB_* ...
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=ats_db
DB_SSL=true
# ... atau connection string
# TARGET_DB_URL=postgres://user:pass@host:5432/ats_db?sslmode=require
