# ==============================================================================
# TENANT CONFIG STUDIO - ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT_BFF=4000
PORT_WEB=3000

# ------------------------------------------------------------------------------
# 1. TARGET DATABASE (Server Konfigurasi yang Dikelola)
# Ubah nilai di bawah untuk berpindah server.
# ------------------------------------------------------------------------------
DB_SSL=true
DB_HOST=your-db-host
DB_PORT=5432
DB_USERNAME=your-username
DB_PASSWORD=your-password
DB_DATABASE=ats_db

# ------------------------------------------------------------------------------
# 2. AUDIT LOG & STUDIO METADATA DATABASE (Tetap NeonDB)
# ------------------------------------------------------------------------------
AUDIT_DB_URL=postgresql://user:password@your-neon-host:5432/ats_db?sslmode=require
AUDIT_DB_SCHEMA=tenant_studio
